    local function executeFlingSingle(target)
        if not target or not target.Character then return end
        if isBrookhaven then
            pcall(function()
                local bp = LP:FindFirstChildOfClass("Backpack")
                local char = Char()
                if bp and bp:FindFirstChild("Couch") and not char:FindFirstChild("Couch") then
                    local keys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five}
                    for _, k in ipairs(keys) do
                        VirtualInputManager:SendKeyEvent(true, k, false, game)
                        VirtualInputManager:SendKeyEvent(false, k, false, game)
                        task.wait(0.05)
                    end
                end

                local myHRP = HRP()
                local origCF = myHRP and myHRP.CFrame
                local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                local tHum = target.Character:FindFirstChildOfClass("Humanoid")

                if myHRP and tHRP then
                    for i = 1, 30 do
                        myHRP.CFrame = tHRP.CFrame * CFrame.new(math.random(-2,2), 0, math.random(-2,2)) * CFrame.Angles(math.random(0,3), math.random(0,3), math.random(0,3))
                        myHRP.AssemblyAngularVelocity = Vector3.new(50000, 50000, 50000)
                        if tHum and (tHum.Sit or tHum:GetState() == Enum.HumanoidStateType.Seated) then
                            myHRP.CFrame = CFrame.new(0, 99999, 0)
                            tHRP.CFrame = CFrame.new(0, 99999, 0)
                            task.wait(0.3)
                            if origCF then myHRP.CFrame = origCF end
                            break
                        end
                        RunService.Heartbeat:Wait()
                    end
                    if origCF then myHRP.CFrame = origCF end
                end
            end)
        else
            pcall(function()
                local myHRP = HRP()
                local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                if myHRP and tHRP then
                    for i = 1, 40 do
                        myHRP.AssemblyAngularVelocity = Vector3.new(0, 10000, 0)
                        myHRP.CFrame = tHRP.CFrame * CFrame.new(math.random(-1, 1), 0, math.random(-1, 1))
                        RunService.Heartbeat:Wait()
                    end
                    myHRP.AssemblyLinearVelocity = Vector3.zero
                    myHRP.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end
    end

    local function stopFly()
        flyActive = false
        if flyBodyVel then flyBodyVel:Destroy() flyBodyVel = nil end
        if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    end

    local function startFly(speedVal)
        stopFly()
        flyActive = true
        local hrp = HRP()
        if not hrp then return end

        flyBodyVel = Instance.new("BodyVelocity")
        flyBodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyBodyVel.Velocity = Vector3.zero
        flyBodyVel.Parent = hrp

        flyBodyGyro = Instance.new("BodyGyro")
        flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyBodyGyro.CFrame = hrp.CFrame
        flyBodyGyro.Parent = hrp

        task.spawn(function()
            while flyActive and HRP() do
                local cam = Workspace.CurrentCamera
                flyBodyGyro.CFrame = cam.CFrame
                flyBodyVel.Velocity = cam.CFrame.LookVector * speedVal
                RunService.RenderStepped:Wait()
            end
        end)
    end

