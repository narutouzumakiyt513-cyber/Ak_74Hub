    local function setupChatCommands(player)
        player.Chatted:Connect(function(message)
            pcall(function()
                local args = string.split(message, " ")
                local cmd = string.lower(args[1] or "")
                
                if player == LP then
                    if cmd == "!fly" then
                        local num = tonumber(args[2]) or 1
                        startFly(num * 10)
                    elseif cmd == "!unfly" then
                        stopFly()
                    elseif cmd == "!speed" then
                        local spd = tonumber(args[2]) or 16
                        local h = Hum()
                        if h then h.WalkSpeed = spd end
                    elseif cmd == "!jp" or cmd == "!jumppower" then
                        local jp = tonumber(args[2]) or 50
                        local h = Hum()
                        if h then h.UseJumpPower = true h.JumpPower = jp end
                    elseif cmd == "!view" then
                        local t = getTargetPlayer(args[2] or "")
                        if t and t.Character and t.Character:FindFirstChild("Humanoid") then
                            Workspace.CurrentCamera.CameraSubject = t.Character.Humanoid
                        end
                    elseif cmd == "!unview" then
                        Workspace.CurrentCamera.CameraSubject = Hum()
                    elseif cmd == "!tpto" then
                        local t = getTargetPlayer(args[2] or "")
                        local myHRP = HRP()
                        if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") and myHRP then
                            myHRP.CFrame = t.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
                        end
                    elseif cmd == "!fling" then
                        if args[2] == "all" then
                            for _, p in ipairs(Players:GetPlayers()) do
                                if p ~= LP then executeFlingSingle(p) end
                            end
                        else
                            local t = getTargetPlayer(args[2] or "")
                            if t then executeFlingSingle(t) end
                        end
                    elseif cmd == "!reset" then
                        local h = Hum()
                        if h then h.Health = 0 end
                    elseif cmd == "!spawnpoint" or cmd == "!spawn" then
                        local myHRP = HRP()
                        if myHRP then
                            customSpawnCFrame = myHRP.CFrame
                            Rayfield:Notify({Title = "Spawn", Content = "Ponto salvo!", Duration = 3})
                        end
                    elseif cmd == "!sus" then
                        local t = getTargetPlayer(args[2] or "")
                        if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
                            pcall(function()
                                local animate = Char():FindFirstChild("Animate")
                                if animate then
                                    local dance = animate:FindFirstChild("dance")
                                    if dance then
                                        local track = dance:FindFirstChildOfClass("Animation")
                                        if track then track.AnimationId = "rbxassetid://5938365243" end
                                    end
                                end
                            end)
                            local myHRP = HRP()
                            if myHRP then
                                myHRP.CFrame = t.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 1.2)
                            end
                        end
                    elseif cmd == "!serverhop" or cmd == "!shop" then
                        pcall(function()
                            local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")).data
                            for _, s in ipairs(servers) do
                                if s.id ~= game.JobId and s.playing < s.maxPlayers then
                                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                                    break
                                end
                            end
                        end)
                    elseif cmd == "!lowserver" or cmd == "!low" then
                        pcall(function()
                            local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")).data
                            table.sort(servers, function(a, b) return a.playing < b.playing end)
                            for _, s in ipairs(servers) do
                                if s.id ~= game.JobId and s.playing > 0 then
                                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                                    break
                                end
                            end
                        end)
                    elseif cmd == "!sla" then
                        Rayfield:Destroy()
                    end
                end

                if hasAdminAccess() and isHubUser(LP) then
                    if cmd == "!kill" or cmd == "_kill" then
                        local t = getTargetPlayer(args[2] or "")
                        if t and isHubUser(t) and t.Character and t.Character:FindFirstChildOfClass("Humanoid") then
                            t.Character:FindFirstChildOfClass("Humanoid").Health = 0
                        end
                    elseif cmd == "!bring" or cmd == "_bring" then
                        local t = getTargetPlayer(args[2] or "")
                        if t and isHubUser(t) then
                            local myHRP = HRP()
                            if myHRP and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
                                t.Character.HumanoidRootPart.CFrame = myHRP.CFrame * CFrame.new(0, 0, -3)
                            end
                        end
                    elseif cmd == "!crashar" then
                        local t = getTargetPlayer(args[2] or "")
                        if t and isHubUser(t) and t == LP then
                            task.spawn(function()
                                local tStart = tick()
                                while tick() - tStart < 5 do
                                    for i = 1, 100000 do local _ = math.sqrt(i) end
                                end
                                LP:Kick("Desconectado do servidor.")
                            end)
                        end
                    elseif cmd == "!rjplayer" or cmd == "!rj" then
                        local t = getTargetPlayer(args[2] or "")
                        if t and isHubUser(t) and t == LP then
                            doRejoin()
                        end
                    end
                end
            end)
        end)
    end

    setupChatCommands(LP)
    Players.PlayerAdded:Connect(function(p)
        setupChatCommands(p)
    end)

    Rayfield:Notify({
        Title = "Ak-74 Hub",
        Content = "Carregado com Sucesso!",
        Duration = 4,
    })
end)

if not Success then
    warn("Erro crítico: " .. tostring(err))
end
