local Success, err = pcall(function()
    local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local TextChatService = game:GetService("TextChatService")
    local TeleportService = game:GetService("TeleportService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Workspace = game:GetService("Workspace")
    local VirtualInputManager = game:GetService("VirtualInputManager")
    local LP = Players.LocalPlayer

    local BROOKHAVEN_ID = 4924922222
    local isBrookhaven = (game.PlaceId == BROOKHAVEN_ID)

    local function Char() return LP.Character end
    local function HRP() local c = Char(); return c and c:FindFirstChild("HumanoidRootPart") end
    local function Hum() local c = Char(); return c and c:FindFirstChildOfClass("Humanoid") end

    local function sendGlobalMessage(txt)
        pcall(function()
            if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                local channels = TextChatService.TextChannels
                if channels and channels:FindFirstChild("RBXGeneral") then
                    channels.RBXGeneral:SendAsync(txt)
                end
            else
                LP:Chat(txt)
            end
        end)
    end

    local Window = Rayfield:CreateWindow({
        Name = isBrookhaven and "Ak-74 Hub - Brookhaven Edition" or "Ak-74 Hub - Universal Edition",
        LoadingTitle = "Carregando Ak-74 Hub...",
        LoadingSubtitle = "by Ak-74",
        ConfigurationSaving = { Enabled = false },
        KeySystem = false,
        Theme = "Ocean"
    })

    local MainTab = Window:CreateTab("Main")
    local TrollTab = Window:CreateTab("Troll")
    
    local AvatarTab, HouseTab, MusicTab
    if isBrookhaven then
        AvatarTab = Window:CreateTab("Avatar")
        HouseTab = Window:CreateTab("House")
        MusicTab = Window:CreateTab("Músicas")
    end

    local CharacterTab = Window:CreateTab("Personagem")
    local TpTab = Window:CreateTab("Teleporte")
    local EspTab = Window:CreateTab("ESP & Visuais")
    local GlobalChatTab = Window:CreateTab("Chat Global")
    local AdminTab = Window:CreateTab("👑Admin")

    local function getPlayerList()
        local list = {}
        pcall(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p and p ~= LP then table.insert(list, p.Name) end
            end
        end)
        if #list == 0 then table.insert(list, "Nenhum jogador") end
        return list
    end

    local function getTargetPlayer(nameStr)
        for _, p in ipairs(Players:GetPlayers()) do
            if p and string.lower(p.Name) == string.lower(nameStr) then return p end
        end
        return nil
    end

    local function equipBrookhavenItem(itemName)
        pcall(function()
            local reFolder = ReplicatedStorage:FindFirstChild("RE")
            if reFolder then
                if reFolder:FindFirstChild("1Too1l") then
                    reFolder["1Too1l"]:FireServer("EquipItem", itemName)
                end
                if reFolder:FindFirstChild("1Item1s") then
                    reFolder["1Item1s"]:FireServer("EquipItem", itemName)
                end
            end
        end)
    end

    MainTab:CreateSection("Geral")

    local function doRejoin()
        pcall(function()
            if #Players:GetPlayers() <= 1 then
                TeleportService:Teleport(game.PlaceId, LP)
            else
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP)
            end
        end)
    end

    MainTab:CreateButton({
        Name = "Rejoin (!rejoin / !rj)",
        Callback = function() doRejoin() end,
    })

    MainTab:CreateButton({
        Name = "Copiar Link do Discord",
        Callback = function()
            if setclipboard then
                setclipboard("https://discord.gg/gj2cGaVdQ")
                Rayfield:Notify({Title = "Sucesso", Content = "Discord copiado!", Duration = 3})
            end
        end,
    })

    local spamText = "Ak-74 Hub"
    MainTab:CreateInput({
        Name = "Texto do Spam",
        PlaceholderText = "Digite o texto...",
        RemoveTextAfterFocusLost = false,
        Callback = function(Value) spamText = Value end,
    })

    MainTab:CreateButton({
        Name = "Executar Spam 7x (!spam)",
        Callback = function()
            task.spawn(function()
                for i = 1, 7 do
                    sendGlobalMessage(spamText)
                    task.wait(0.5)
                end
            end)
        end,
    })

    TrollTab:CreateSection("Controle de Troll & Fling")
    local selectedTarget = "Nenhum jogador"

    local DropdownTroll = TrollTab:CreateDropdown({
        Name = "Selecionar Vítima",
        Options = getPlayerList(),
        CurrentOption = "Nenhum jogador",
        Callback = function(Option) selectedTarget = Option[1] or Option end,
    })

    TrollTab:CreateButton({
        Name = "Atualizar Lista de Jogadores",
        Callback = function() DropdownTroll:Refresh(getPlayerList()) end,
    })

    local viewActive = false
    TrollTab:CreateToggle({
        Name = "View (Invadir Câmera da Vítima)",
        CurrentValue = false,
        Callback = function(Value)
            viewActive = Value
            task.spawn(function()
                while viewActive do
                    pcall(function()
                        local target = getTargetPlayer(selectedTarget)
                        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                            Workspace.CurrentCamera.CameraSubject = target.Character.Humanoid
                        else
                            Workspace.CurrentCamera.CameraSubject = Hum()
                        end
                    end)
                    RunService.RenderStepped:Wait()
                end
                Workspace.CurrentCamera.CameraSubject = Hum()
            end)
        end,
    })

    local normalFlingActive = false
    TrollTab:CreateToggle({
        Name = "Fling Normal",
        CurrentValue = false,
        Callback = function(Value)
            normalFlingActive = Value
            task.spawn(function()
                while normalFlingActive do
                    pcall(function()
                        local myHRP = HRP()
                        local target = getTargetPlayer(selectedTarget)
                        if myHRP and target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                            myHRP.AssemblyAngularVelocity = Vector3.new(0, 10000, 0)
                            myHRP.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(math.random(-1, 1), 0, math.random(-1, 1))
                        end
                    end)
                    RunService.Heartbeat:Wait()
                end
                local myHRP = HRP()
                if myHRP then
                    myHRP.AssemblyLinearVelocity = Vector3.zero
                    myHRP.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end,
    })

    local flingAllActive = false
    TrollTab:CreateToggle({
        Name = "Fling All",
        CurrentValue = false,
        Callback = function(Value)
            flingAllActive = Value
            task.spawn(function()
                while flingAllActive do
                    pcall(function()
                        local myHRP = HRP()
                        if myHRP then
                            for _, p in ipairs(Players:GetPlayers()) do
                                if p and p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                                    myHRP.AssemblyAngularVelocity = Vector3.new(0, 20000, 0)
                                    myHRP.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(math.random(-1, 1), 0, math.random(-1, 1))
                                    RunService.Heartbeat:Wait()
                                end
                            end
                        end
                    end)
                    RunService.Heartbeat:Wait()
                end
                local myHRP = HRP()
                if myHRP then
                    myHRP.AssemblyLinearVelocity = Vector3.zero
                    myHRP.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end,
    })

    if isBrookhaven then
        TrollTab:CreateSection("Trolls Especiais Brookhaven")

        local couchFlingActive = false
        TrollTab:CreateToggle({
            Name = "Fling Couch (Sofá)",
            CurrentValue = false,
            Callback = function(Value)
                couchFlingActive = Value
                if couchFlingActive then
                    task.spawn(function()
                        local bp = LP:FindFirstChildOfClass("Backpack")
                        local char = Char()
                        local tool = char and char:FindFirstChild("Couch") or (bp and bp:FindFirstChild("Couch"))

                        if not tool then
                            Rayfield:Notify({Title = "Aviso", Content = "Couch não identificado. Pegue manualmente.", Duration = 4})
                        end

                        if bp and bp:FindFirstChild("Couch") and not char:FindFirstChild("Couch") then
                            local keys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine}
                            for _, k in ipairs(keys) do
                                VirtualInputManager:SendKeyEvent(true, k, false, game)
                                VirtualInputManager:SendKeyEvent(false, k, false, game)
                                task.wait(0.05)
                            end
                            task.wait(0.2)
                        end

                        local myHRP = HRP()
                        local originalCFrame = myHRP and myHRP.CFrame

                        while couchFlingActive do
                            pcall(function()
                                local target = getTargetPlayer(selectedTarget)
                                local currentHRP = HRP()
                                if currentHRP and target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                                    local targetHRP = target.Character.HumanoidRootPart
                                    local targetHum = target.Character:FindFirstChildOfClass("Humanoid")

                                    currentHRP.CFrame = targetHRP.CFrame * CFrame.new(math.random(-2,2), 0, math.random(-2,2)) * CFrame.Angles(math.random(0,3), math.random(0,3), math.random(0,3))
                                    currentHRP.AssemblyAngularVelocity = Vector3.new(50000, 50000, 50000)

                                    if targetHum and (targetHum.Sit or targetHum:GetState() == Enum.HumanoidStateType.Seated) then
                                        currentHRP.CFrame = CFrame.new(0, 99999, 0)
                                        targetHRP.CFrame = CFrame.new(0, 99999, 0)
                                        task.wait(0.3)
                                        if originalCFrame then
                                            currentHRP.CFrame = originalCFrame
                                        end
                                        couchFlingActive = false
                                    end
                                end
                            end)
                            RunService.Heartbeat:Wait()
                        end
                    end)
                end
            end,
        })
        TrollTab:CreateParagraph({Title = "Info Couch", Content = "pegar couch manualmente, pois n consigo arrumar essa porr#"})

        TrollTab:CreateButton({
            Name = "Equipar Ônibus (Bus) - n funciona",
            Callback = function()
                Rayfield:Notify({Title = "Aviso", Content = "Bus n funciona.", Duration = 3})
            end,
        })

        TrollTab:CreateButton({
            Name = "Equipar Guincho (TowTruck) - n funciona",
            Callback = function()
                Rayfield:Notify({Title = "Aviso", Content = "Guincho n funciona.", Duration = 3})
            end,
        })
    end

    if isBrookhaven then
        AvatarTab:CreateSection("Customização de Avatar")
        AvatarTab:CreateButton({
            Name = "Remover Rosto",
            Callback = function()
                pcall(function() ReplicatedStorage.RE["1Avatar1RemoveFace"]:FireServer() end)
            end,
        })

        HouseTab:CreateSection("Controle de Casas")
        HouseTab:CreateButton({
            Name = "Destrancar Portas (Local)",
            Callback = function()
                Rayfield:Notify({Title = "House", Content = "Função carregada.", Duration = 3})
            end,
        })

        MusicTab:CreateSection("Controle de Som / Boombox")
        local musicIdInput = ""
        MusicTab:CreateInput({
            Name = "ID da Música (Roblox Asset ID)",
            PlaceholderText = "Ex: 18483545",
            RemoveTextAfterFocusLost = false,
            Callback = function(Value) musicIdInput = Value end,
        })

        MusicTab:CreateButton({
            Name = "Tocar Música na Caixa de Som",
            Callback = function()
                pcall(function()
                    equipBrookhavenItem("Boombox")
                    task.wait(0.3)
                    local re = ReplicatedStorage:FindFirstChild("RE")
                    if re and re:FindFirstChild("1Music1") then
                        re["1Music1"]:FireServer(tonumber(musicIdInput) or 0)
                        Rayfield:Notify({Title = "Boombox", Content = "Música enviada para tocar!", Duration = 3})
                    else
                        local tool = Char() and Char():FindFirstChild("Boombox") or (LP.Backpack and LP.Backpack:FindFirstChild("Boombox"))
                        if tool and tool:FindFirstChild("Remote") then
                            tool.Remote:FireServer(tonumber(musicIdInput) or 0)
                        end
                    end
                end)
            end,
        })
    end

    CharacterTab:CreateSection("Ações")
    CharacterTab:CreateToggle({
        Name = "Invincible Fly",
        CurrentValue = false,
        Callback = function(Value)
            if Value then
                pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/396abc/Script/refs/heads/main/MobileFly.lua"))() end)
            end
        end,
    })

    CharacterTab:CreateButton({
        Name = "Curar Personagem",
        Callback = function()
            local h = Hum()
            if h then h.Health = h.MaxHealth end
        end,
    })

    TpTab:CreateSection("Ferramentas de TP")
    TpTab:CreateButton({
        Name = "Pegar TP Tool (Clique para TP)",
        Callback = function()
            pcall(function()
                local bp = LP:FindFirstChildOfClass("Backpack")
                if not bp then return end
                local t = Instance.new("Tool")
                t.Name = "TP Tool"
                t.RequiresHandle = false
                t.Activated:Connect(function()
                    pcall(function()
                        local mouse = LP:GetMouse()
                        local hrp = HRP()
                        if hrp and mouse and mouse.Hit then 
                            hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0)) 
                        end
                    end)
                end)
                t.Parent = bp
            end)
        end,
    })

    EspTab:CreateSection("Visuais")
    local espActive = false
    local espStorage = {}

    EspTab:CreateToggle({
        Name = "ESP Completo",
        CurrentValue = false,
        Callback = function(Value)
            espActive = Value
            for _, v in pairs(espStorage) do if v then v:Destroy() end end
            espStorage = {}
            if not espActive then return end
            task.spawn(function()
                while espActive do
                    pcall(function()
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p and p ~= LP and p.Character then
                                local model = p.Character
                                local head = model:FindFirstChild("Head") or model:FindFirstChildOfClass("BasePart")
                                if head and not model:FindFirstChild("AkESP") then
                                    local bb = Instance.new("BillboardGui")
                                    bb.Name = "AkESP"
                                    bb.Adornee = head
                                    bb.Size = UDim2.new(0, 200, 0, 50)
                                    bb.StudsOffset = Vector3.new(0, 2.5, 0)
                                    bb.AlwaysOnTop = true
                                    local txt = Instance.new("TextLabel")
                                    txt.Size = UDim2.new(1, 0, 1, 0)
                                    txt.BackgroundTransparency = 1
                                    txt.TextColor3 = Color3.fromRGB(0, 255, 150)
                                    txt.TextStrokeTransparency = 0
                                    txt.TextSize = 12
                                    txt.Text = p.Name
                                    txt.Parent = bb
                                    bb.Parent = head
                                    table.insert(espStorage, bb)
                                end
                            end
                        end
                    end)
                    task.wait(2)
                end
            end)
        end,
    })

    GlobalChatTab:CreateSection("Transmissão Global")
    local globalMsgInput = "Ak-74 Hub Global"
    GlobalChatTab:CreateInput({
        Name = "Mensagem Global",
        PlaceholderText = "Digite a mensagem...",
        RemoveTextAfterFocusLost = false,
        Callback = function(Value) globalMsgInput = Value end,
    })

    GlobalChatTab:CreateButton({
        Name = "Enviar Mensagem Global",
        Callback = function()
            sendGlobalMessage(globalMsgInput)
            Rayfield:Notify({Title = "Chat Global", Content = "Mensagem enviada!", Duration = 3})
        end,
    })

    AdminTab:CreateSection("Painel Administrativo Restrito")

    local function hasAdminAccess()
        return LP.UserId == 11897042146 or LP.UserId == 11706636038 or LP.Name == "Ak_74OutraConta" or LP.Name == "MR_banguela2"
    end
    LP:SetAttribute("AkHubActive", true)

    local adminTargetInput = ""
    AdminTab:CreateInput({
        Name = "Nick do Alvo",
        PlaceholderText = "Digite parte do nick...",
        RemoveTextAfterFocusLost = false,
        Callback = function(Value) adminTargetInput = Value end,
    })

    local function isHubUser(player)
        if not player then return false end
        local successAttr, attrVal = pcall(function() return player:GetAttribute("AkHubActive") end)
        return (successAttr and attrVal == true) or player.Name == "Ak_74OutraConta" or player.Name == "MR_banguela2"
    end

    AdminTab:CreateButton({
        Name = "!Verify (Verificar Usuários do Hub)",
        Callback = function()
            pcall(function()
                if not hasAdminAccess() then Rayfield:Notify({Title = "Acesso Negado", Content = "Sem permissão!", Duration = 3}) return end
                local found = {}
                for _, p in ipairs(Players:GetPlayers()) do if isHubUser(p) then table.insert(found, p.Name) end end
                Rayfield:Notify({Title = "Verificação", Content = #found > 0 and table.concat(found, ", ") or "Nenhum user encontrado", Duration = 4})
            end)
        end,
    })

    AdminTab:CreateButton({
        Name = "!Kill (Matar Alvo)",
        Callback = function()
            pcall(function()
                if not hasAdminAccess() then Rayfield:Notify({Title = "Acesso Negado", Content = "Sem permissão!", Duration = 3}) return end
                local t = getTargetPlayer(adminTargetInput)
                if t then
                    if not isHubUser(t) then Rayfield:Notify({Title = "Aviso", Content = t.Name .. " não é user do Ak Hub.", Duration = 4}) return end
                    if t.Character and t.Character:FindFirstChildOfClass("Humanoid") then
                        t.Character:FindFirstChildOfClass("Humanoid").Health = 0
                    end
                end
            end)
        end,
    })

    local kickReason = "Abuso"
    AdminTab:CreateInput({
        Name = "Motivo do Kick",
        PlaceholderText = "Motivo...",
        RemoveTextAfterFocusLost = false,
        Callback = function(Value) kickReason = Value end,
    })

    AdminTab:CreateButton({
        Name = "!Kick (Expulsar Alvo)",
        Callback = function()
            pcall(function()
                if not hasAdminAccess() then Rayfield:Notify({Title = "Acesso Negado", Content = "Sem permissão!", Duration = 3}) return end
                local t = getTargetPlayer(adminTargetInput)
                if t then
                    if not isHubUser(t) then Rayfield:Notify({Title = "Aviso", Content = t.Name .. " não é user do Ak Hub.", Duration = 4}) return end
                    t:Kick("Expulsado do Hub: " .. kickReason)
                end
            end)
        end,
    })

    AdminTab:CreateButton({
        Name = "!Bring (Puxar Alvo até Você)",
        Callback = function()
            pcall(function()
                if not hasAdminAccess() then Rayfield:Notify({Title = "Acesso Negado", Content = "Sem permissão!", Duration = 3}) return end
                local t = getTargetPlayer(adminTargetInput)
                if t then
                    if not isHubUser(t) then Rayfield:Notify({Title = "Aviso", Content = t.Name .. " não é user do Ak Hub.", Duration = 4}) return end
                    local myHRP = HRP()
                    if myHRP and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
                        t.Character.HumanoidRootPart.CFrame = myHRP.CFrame * CFrame.new(0, 0, -3)
                    end
                end
            end)
        end,
    })

    local controllChatActive = false
    AdminTab:CreateToggle({
        Name = "!ControllChat (Monitorar Chat do Alvo)",
        CurrentValue = false,
        Callback = function(Value)
            controllChatActive = Value
            pcall(function()
                if not hasAdminAccess() then Rayfield:Notify({Title = "Acesso Negado", Content = "Sem permissão!", Duration = 3}) return end
                if controllChatActive then
                    Rayfield:Notify({Title = "ControllChat", Content = "Ativado! Monitorando falas...", Duration = 3})
                    local target = getTargetPlayer(adminTargetInput)
                    if target then
                        target.Chatted:Connect(function(msg)
                            if controllChatActive then
                                Rayfield:Notify({Title = "Chat de " .. target.Name, Content = msg, Duration = 5})
                            end
                        end)
                    end
                else
                    Rayfield:Notify({Title = "ControllChat", Content = "Desativado.", Duration = 3})
                end
            end)
        end,
    })

    local forcedChatMessage = "Ak-74 Hub Dominou!"
    AdminTab:CreateInput({
        Name = "Mensagem para Forçar no Chat do Alvo",
        PlaceholderText = "Digite o que o alvo vai falar...",
        RemoveTextAfterFocusLost = false,
        Callback = function(Value) forcedChatMessage = Value end,
    })

    AdminTab:CreateButton({
        Name = "Forçar Alvo a Enviar a Mensagem",
        Callback = function()
            pcall(function()
                if not hasAdminAccess() then Rayfield:Notify({Title = "Acesso Negado", Content = "Sem permissão!", Duration = 3}) return end
                local t = getTargetPlayer(adminTargetInput)
                if t and t.Character then
                    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                        local channels = TextChatService.TextChannels
                        if channels and channels:FindFirstChild("RBXGeneral") then
                            channels.RBXGeneral:SendAsync(forcedChatMessage)
                        end
                    else
                        t:Chat(forcedChatMessage)
                    end
                    Rayfield:Notify({Title = "ControllChat", Content = "Mensagem forçada no chat!", Duration = 3})
                end
            end)
        end,
    })

    local function setupChatCommands(player)
        player.Chatted:Connect(function(message)
            pcall(function()
                local args = string.split(message, " ")
                local cmd = string.lower(args[1] or "")
                
                if cmd == "!rejoin" or cmd == "_rejoin" or cmd == "!rj" then
                    doRejoin()
                elseif cmd == "!spam" or cmd == "_spam" then
                    table.remove(args, 1)
                    local customMsg = table.concat(args, " ")
                    if customMsg == "" then customMsg = "Ak-74 Hub" end
                    task.spawn(function()
                        for i = 1, 7 do
                            sendGlobalMessage(customMsg)
                            task.wait(0.5)
                        end
                    end)
                elseif cmd == "!kill" or cmd == "_kill" then
                    if hasAdminAccess() then
                        table.remove(args, 1)
                        local targetName = args[1]
                        local t = getTargetPlayer(targetName)
                        if t and isHubUser(t) and t.Character and t.Character:FindFirstChildOfClass("Humanoid") then
                            t.Character:FindFirstChildOfClass("Humanoid").Health = 0
                        end
                    end
                elseif cmd == "!bring" or cmd == "_bring" then
                    if hasAdminAccess() then
                        table.remove(args, 1)
                        local targetName = args[1]
                        local t = getTargetPlayer(targetName)
                        if t and isHubUser(t) then
                            local myHRP = HRP()
                            if myHRP and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
                                t.Character.HumanoidRootPart.CFrame = myHRP.CFrame * CFrame.new(0, 0, -3)
                            end
                        end
                    end
                end
            end)
        end)
    end

    setupChatCommands(LP)
    Players.PlayerAdded:Connect(function(p)
        setupChatCommands(p)
    end)

    Rayfield:Notify({
        Title = "Ak-74 Hub",
        Content = "676767",
        Duration = 4,
    })
end)

if not Success then
    warn("Erro crítico: " .. tostring(err))
